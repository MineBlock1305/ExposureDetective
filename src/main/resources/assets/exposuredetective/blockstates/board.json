    { "when": { "facing": "north", "corner_left_up": "true" }, "apply": { "model": "exposuredetective:block/board_border_left_up" } },
    { "when": { "facing": "east",  "corner_left_up": "true" }, "apply": { "model": "exposuredetective:block/board_border_left_up", "y": 90 } },
    { "when": { "facing": "south", "corner_left_up": "true" }, "apply": { "model": "exposuredetective:block/board_border_left_up", "y": 180 } },
    { "when": { "facing": "west",  "corner_left_up": "true" }, "apply": { "model": "exposuredetective:block/board_border_left_up", "y": 270 } },

    { "when": { "facing": "north", "corner_left_down": "true" }, "apply": { "model": "exposuredetective:block/board_border_left_down" } },
    { "when": { "facing": "east",  "corner_left_down": "true" }, "apply": { "model": "exposuredetective:block/board_border_left_down", "y": 90 } },
