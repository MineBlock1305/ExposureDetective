    { "when": { "facing": "south", "corner_right_down": "true" }, "apply": { "model": "exposuredetective:block/board_border_right_down", "y": 180 } },
    { "when": { "facing": "west",  "corner_right_down": "true" }, "apply": { "model": "exposuredetective:block/board_border_right_down", "y": 270 } }
  ]
}
