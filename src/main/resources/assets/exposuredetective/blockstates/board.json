    { "when": { "facing": "west",  "border_down": "true" }, "apply": { "model": "exposuredetective:block/board_border_down", "y": 270 } },

    { "when": { "facing": "north", "border_left": "true" }, "apply": { "model": "exposuredetective:block/board_border_left" } },
